-- FishMacro_v2.lua | Luau, executor context
-- Records ONE fishing cycle you perform yourself: your client -> server calls AND the
-- server -> client events in between. Replays the cycle in a loop. Tap a server event
-- to make the replay WAIT for it, then send the next call right after it arrives.
-- No remote names or arguments are hardcoded. Status: NOT run in any executor.

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")

----------------------------------------------------------------------
-- Config. Everything here is UNCALIBRATED; tune in-game.
----------------------------------------------------------------------
local Config = {
	StepSpeed = 0, -- multiplier on recorded gaps between played items; 0 = no waiting
	CycleDelay = 0, -- seconds between cycles; 0 = one frame
	EventTimeout = 15, -- seconds to wait for a marked server event
	MaxConsecutiveFailures = 5,
	NoiseLearnSeconds = 5,
	-- Optional: function(itemIndex, args) -> args, for values that must change per cycle.
	Transform = nil,
}

local MAX_ITEMS, MAX_PER_EVENT = 120, 3
local MAX_STR, MAX_DEPTH, MAX_TABLE_ENTRIES = 60, 3, 16

----------------------------------------------------------------------
-- Capability check
----------------------------------------------------------------------
local hasNamecall = type(hookmetamethod) == "function"
	and type(getnamecallmethod) == "function"
	and type(newcclosure) == "function"
	and type(checkcaller) == "function"
local hasFnHook = type(hookfunction) == "function"
	and type(newcclosure) == "function"
	and type(checkcaller) == "function"
if not hasNamecall and not hasFnHook then
	warn("[FishMacro] executor tidak punya hookmetamethod/getnamecallmethod ATAU hookfunction -> berhenti")
	return
end

----------------------------------------------------------------------
-- Pure helpers
----------------------------------------------------------------------
local REMOTE_CLASSES = { RemoteEvent = true, RemoteFunction = true, UnreliableRemoteEvent = true }

local function serialize(v, depth, seen)
	local t = typeof(v)
	if t == "string" then
		local s = #v > MAX_STR and (string.sub(v, 1, MAX_STR) .. "...") or v
		return string.format("%q", s)
	elseif t == "number" or t == "boolean" or t == "nil" then
		return tostring(v)
	elseif t == "Instance" then
		local ok, full = pcall(v.GetFullName, v)
		return ok and ("<" .. full .. ">") or "<Instance>"
	elseif t == "table" then
		if depth >= MAX_DEPTH then
			return "{...}"
		end
		if seen[v] then
			return "{<cycle>}"
		end
		seen[v] = true
		local parts, n = {}, 0
		for k, val in pairs(v) do
			n += 1
			if n > MAX_TABLE_ENTRIES then
				parts[#parts + 1] = "..."
				break
			end
			parts[#parts + 1] = "[" .. serialize(k, depth + 1, seen) .. "]=" .. serialize(val, depth + 1, seen)
		end
		seen[v] = nil
		return "{" .. table.concat(parts, ", ") .. "}"
	end
	local ok, s = pcall(tostring, v)
	return ok and (t .. ":" .. s) or t
end

local function serializeArgs(args)
	local parts = {}
	for i = 1, args.n do
		parts[i] = serialize(args[i], 0, {})
	end
	return table.concat(parts, ", ")
end

-- Copies plain tables (cycle-safe); Instances and other values are kept by reference.
local function snapshot(v, depth, seen)
	if type(v) ~= "table" or depth >= 6 then
		return v
	end
	if seen[v] then
		return seen[v]
	end
	local c = {}
	seen[v] = c
	for k, val in pairs(v) do
		c[snapshot(k, depth + 1, seen)] = snapshot(val, depth + 1, seen)
	end
	return c
end

local function snapshotArgs(args)
	local out = { n = args.n }
	for i = 1, args.n do
		out[i] = snapshot(args[i], 0, {})
	end
	return out
end

local function hasDeadInstance(v, depth)
	if typeof(v) == "Instance" then
		return not v:IsDescendantOf(game)
	end
	if type(v) == "table" and depth < 4 then
		for _, val in pairs(v) do
			if hasDeadInstance(val, depth + 1) then
				return true
			end
		end
	end
	return false
end

local function firstDeadArg(args)
	for i = 1, args.n do
		if hasDeadInstance(args[i], 0) then
			return i
		end
	end
	return nil
end

----------------------------------------------------------------------
-- State + single cleanup path
----------------------------------------------------------------------
if _G.__FMStop then
	pcall(_G.__FMStop)
end

local state = { running = true, mode = "idle", raw = 0, cycles = 0, timeouts = 0, seq = 0 }
-- mode: idle | noise | record | replay
local items, rows = {}, {}
local noise, eventSeen = {}, {}
local connections, listenConns, syncConns = {}, {}, {}
local evCount, consumed = {}, {}
local gui

local function track(signal, fn)
	local c = signal:Connect(fn)
	table.insert(connections, c)
	return c
end

local function disconnectAll(list)
	for _, c in ipairs(list) do
		c:Disconnect()
	end
	table.clear(list)
end

local function stop()
	state.running = false
	state.mode = "idle"
	_G.__FMHandler = nil -- hooks stay installed as pass-throughs
	disconnectAll(connections)
	disconnectAll(listenConns)
	disconnectAll(syncConns)
	if gui then
		gui:Destroy()
		gui = nil
	end
	_G.__FMStop = nil
end
_G.__FMStop = stop

