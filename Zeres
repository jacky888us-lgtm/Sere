local function refreshButtons()
	recBtn.Text = (state.mode == "record") and "Stop rec" or "Rec"
	runBtn.Text = (state.mode == "replay") and "Stop" or "Run"
	recBtn.BackgroundColor3 = (state.mode == "record") and COLORS.on or COLORS.item
	runBtn.BackgroundColor3 = (state.mode == "replay") and COLORS.on or COLORS.item
end

local function setMode(mode)
	local was = state.mode
	state.mode = mode
	local listen = (mode == "noise" or mode == "record")
	local wasListen = (was == "noise" or was == "record")
	if listen and not wasListen then
		startListening()
	elseif wasListen and not listen then
		disconnectAll(listenConns)
	end
	if was == "replay" and mode ~= "replay" then
		disconnectAll(syncConns)
	end
	refreshButtons()
end

----------------------------------------------------------------------
-- Replay
----------------------------------------------------------------------
local function armSyncListeners()
	disconnectAll(syncConns)
	table.clear(evCount)
	table.clear(consumed)
	for i, it in ipairs(items) do
		if it.kind == "event" and it.sync and evCount[it.remote] == nil then
			if not it.remote:IsDescendantOf(game) then
				return false, "event di baris " .. i .. " sudah hilang dari game, rekam ulang"
			end
			evCount[it.remote], consumed[it.remote] = 0, 0
			local remote = it.remote
			local ok, conn = pcall(function()
				return remote.OnClientEvent:Connect(function()
					evCount[remote] += 1
				end)
			end)
			if not ok then
				return false, "gagal listen event baris " .. i
			end
			table.insert(syncConns, conn)
		end
	end
	return true
end

local function waitForEvent(remote)
	local deadline = os.clock() + Config.EventTimeout
	while state.running and state.mode == "replay" do
		if evCount[remote] > consumed[remote] then
			consumed[remote] = evCount[remote]
			return true
		end
		if os.clock() >= deadline then
			return false
		end
		task.wait() -- polls once per frame; this is the smallest possible reaction step
	end
	return false
end

local function fire(it, args)
	if it.method == "FireServer" then
		it.remote:FireServer(table.unpack(args, 1, args.n))
	else
		it.remote:InvokeServer(table.unpack(args, 1, args.n))
	end
end

local function readNumber(box, fallback)
	local n = tonumber(box.Text)
	if n == nil or n ~= n or n < 0 or n > 60 then
		box.Text = tostring(fallback)
		return fallback
	end
	return n
end

local function failStop(text)
	setMessage(text, false)
	setMode("idle")
end

local function replayLoop()
	local failStreak = 0
	while state.running and state.mode == "replay" do
		Config.StepSpeed = readNumber(speedBox, Config.StepSpeed)
		Config.CycleDelay = readNumber(delayBox, Config.CycleDelay)
		local prevT, aborted = nil, false
		for i, it in ipairs(items) do
			if not (state.running and state.mode == "replay") then
				return
			end
			if it.kind == "event" then
				if it.sync then
					if not waitForEvent(it.remote) then
						if state.mode ~= "replay" then
							return
						end
						state.timeouts += 1
						failStreak += 1
						if failStreak >= Config.MaxConsecutiveFailures then
							failStop("event baris " .. i .. " tidak datang " .. failStreak .. "x berturut-turut")
							return
						end
						aborted = true
						break
					end
					prevT = it.t
				end
			elseif it.enabled then
				if not it.remote:IsDescendantOf(game) then
					failStop("baris " .. i .. ": remote sudah hilang dari game")
					return
				end
				local args = snapshotArgs(it.args)
				if Config.Transform then
					local ok, res = pcall(Config.Transform, i, args)
					if ok and type(res) == "table" and type(res.n) == "number" then
						args = res
					end
				end
				local dead = firstDeadArg(args)
				if dead then
					failStop("baris " .. i .. ", argumen " .. dead .. ": Instance sudah hilang, rekam ulang")
					return
				end
				if prevT and Config.StepSpeed > 0 then
					local wait = (it.t - prevT) * Config.StepSpeed
					if wait > 0 then
						task.wait(wait)
					end
				end
				prevT = it.t
				local ok, err = pcall(fire, it, args)
				if ok then
					failStreak = 0
				else
					failStreak += 1
					if failStreak >= Config.MaxConsecutiveFailures then
						failStop("gagal " .. failStreak .. "x berturut-turut: " .. tostring(err))
						return
					end
				end
			end
		end
		if not aborted then
			state.cycles += 1
		end
		task.wait(Config.CycleDelay)
	end
end

