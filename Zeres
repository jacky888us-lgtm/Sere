local function rowText(it)
	if it.kind == "call" then
		return string.format("%d. %s:%s(%s)", it.index, it.path, it.method, serializeArgs(it.args))
	end
	return string.format("%d. <- %s%s(%s)", it.index, it.sync and "[TUNGGU] " or "", it.path, it.desc)
end

local function paintRow(row, it)
	row.Text = rowText(it)
	if it.kind == "call" then
		row.BackgroundColor3 = COLORS.item
		row.BackgroundTransparency = it.enabled and 0 or 0.7
		row.TextTransparency = it.enabled and 0 or 0.5
		row.TextColor3 = COLORS.text
	else
		row.BackgroundColor3 = it.sync and COLORS.on or COLORS.item
		row.BackgroundTransparency = it.sync and 0 or 0.7
		row.TextTransparency = it.sync and 0 or 0.35
		row.TextColor3 = COLORS.hit
	end
end

local function addRow(it)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, -6, 0, 0)
	b.AutomaticSize = Enum.AutomaticSize.Y
	b.BackgroundColor3 = COLORS.item
	b.TextWrapped = true
	b.Font = Enum.Font.Code
	b.TextSize = 11
	b.TextXAlignment = Enum.TextXAlignment.Left
	b.LayoutOrder = it.index
	b.Parent = list
	corner(b, 4)
	paintRow(b, it)
	b.MouseButton1Click:Connect(function()
		if state.mode == "replay" then
			return
		end
		if it.kind == "call" then
			it.enabled = not it.enabled
		else
			it.sync = not it.sync
		end
		paintRow(b, it)
	end)
	rows[it] = b
end

local function rebuildRows()
	for _, r in pairs(rows) do
		r:Destroy()
	end
	table.clear(rows)
	for i, it in ipairs(items) do
		it.index = i
		addRow(it)
	end
end

local function clearItems()
	for _, r in pairs(rows) do
		r:Destroy()
	end
	table.clear(rows)
	table.clear(items)
	table.clear(eventSeen)
end

local function pushItem(it)
	state.seq += 1
	it.seq = state.seq
	table.insert(items, it)
	it.index = #items
	addRow(it)
end

----------------------------------------------------------------------
-- Intake: client -> server calls (hook) and server -> client events (listeners)
----------------------------------------------------------------------
local function onCall(remote, method, args, t)
	if not state.running or state.mode ~= "record" then
		return
	end
	pcall(function()
		if typeof(remote) ~= "Instance" or not REMOTE_CLASSES[remote.ClassName] then
			return
		end
		local path = remote:GetFullName()
		if noise["C:" .. path] or #items >= MAX_ITEMS then
			return
		end
		pushItem({
			kind = "call", remote = remote, method = method, path = path,
			args = snapshotArgs(args), t = t, enabled = true,
		})
	end)
end

local function onCallNoise(remote)
	pcall(function()
		if typeof(remote) == "Instance" and REMOTE_CLASSES[remote.ClassName] then
			noise["C:" .. remote:GetFullName()] = true
		end
	end)
end

_G.__FMHandler = function(self, method, ...)
	if not state.running then
		return
	end
	state.raw += 1
	if state.mode == "noise" then
		task.defer(onCallNoise, self)
	elseif state.mode == "record" then
		task.defer(onCall, self, method, table.pack(...), os.clock())
	end
end

local function onEvent(remote, args, t)
	if not state.running then
		return
	end
	pcall(function()
		local path = remote:GetFullName()
		if state.mode == "noise" then
			noise["E:" .. path] = true
		elseif state.mode == "record" then
			if noise["E:" .. path] or #items >= MAX_ITEMS then
				return
			end
			eventSeen[path] = (eventSeen[path] or 0) + 1
			if eventSeen[path] > MAX_PER_EVENT then
				return
			end
			pushItem({
				kind = "event", remote = remote, path = path,
				desc = serializeArgs(args), t = t, sync = false,
			})
		end
	end)
end

local function collectEvents()
	local out = {}
	local roots = {
		game:GetService("ReplicatedStorage"),
		game:GetService("ReplicatedFirst"),
		Players.LocalPlayer,
		Players.LocalPlayer and Players.LocalPlayer.Character,
	}
	for _, root in pairs(roots) do
		local ok, descendants = pcall(function() return root:GetDescendants() end)
		if ok then
			for _, inst in ipairs(descendants) do
				local cn = inst.ClassName
				if cn == "RemoteEvent" or cn == "UnreliableRemoteEvent" then
					out[#out + 1] = inst
				end
			end
		end
	end
	return out
end

local function startListening()
	disconnectAll(listenConns)
	for _, remote in ipairs(collectEvents()) do
		local ok, conn = pcall(function()
			return remote.OnClientEvent:Connect(function(...)
				onEvent(remote, table.pack(...), os.clock())
			end)
		end)
		if ok then
			table.insert(listenConns, conn)
		end
	end
end

----------------------------------------------------------------------
-- Hooks: installed once per session; only the handler is swapped on rerun
----------------------------------------------------------------------
if not _G.__FMHooked then
	local installed = { namecall = false, fn = 0 }
	local recent = setmetatable({}, { __mode = "k" })

	if hasNamecall then
		installed.namecall = pcall(function()
			local oldNamecall
			oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
				local method = getnamecallmethod()
				if (method == "FireServer" or method == "InvokeServer") and not checkcaller() then
					if typeof(self) == "Instance" then
						recent[self] = os.clock()
					end
					local handler = _G.__FMHandler
					if handler then
						pcall(handler, self, method, ...)
					end
				end
				if setnamecallmethod then
					setnamecallmethod(method)
				end
				return oldNamecall(self, ...)
			end))
		end)
	end

	if hasFnHook then
		for _, pair in ipairs({
			{ "RemoteEvent", "FireServer" },
			{ "RemoteFunction", "InvokeServer" },
			{ "UnreliableRemoteEvent", "FireServer" },
		}) do
			local className, methodName = pair[1], pair[2]
			if pcall(function()
				local inst = Instance.new(className)
				local fn = inst[methodName]
				inst:Destroy()
				local old
				old = hookfunction(fn, newcclosure(function(self, ...)
					if not checkcaller() and self ~= nil then
						local t = recent[self]
						if not (t and os.clock() - t < 0.01) then
							local handler = _G.__FMHandler
							if handler then
								pcall(handler, self, methodName, ...)
							end
						end
					end
					return old(self, ...)
				end))
			end) then
				installed.fn += 1
			end
		end
	end
	_G.__FMHooked = installed
end
local hooked = _G.__FMHooked

