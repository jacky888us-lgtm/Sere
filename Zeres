		setMode("idle")
		table.sort(items, function(a, b)
			if a.t ~= b.t then
				return a.t < b.t
			end
			return a.seq < b.seq
		end)
		rebuildRows()
		setMessage(#items .. " item terekam. tap '<-' event server buat TUNGGU, tap call buat skip, lalu Run", #items > 0)
	elseif state.mode == "idle" then
		clearItems()
		setMode("record")
		setMessage("merekam: mancing 1 putaran penuh lalu tekan Stop rec", true)
	else
		setMessage("selesaikan mode " .. state.mode .. " dulu", false)
	end
end)

track(runBtn.MouseButton1Click, function()
	if state.mode == "replay" then
		setMode("idle")
		setMessage("berhenti. siklus selesai: " .. state.cycles, true)
		return
	end
	if state.mode ~= "idle" then
		setMessage("selesaikan mode " .. state.mode .. " dulu", false)
		return
	end
	local calls = 0
	for _, it in ipairs(items) do
		if it.kind == "call" and it.enabled then
			calls += 1
		end
	end
	if calls == 0 then
		setMessage("belum ada call aktif, rekam dulu", false)
		return
	end
	local armed, err = armSyncListeners()
	if not armed then
		setMessage(err, false)
		return
	end
	state.cycles, state.timeouts = 0, 0
	setMode("replay")
	setMessage("jalan: " .. calls .. " call per siklus", true)
	task.spawn(replayLoop)
end)

task.spawn(function()
	while state.running and gui do
		diagLabel.Text = string.format(
			"hook namecall=%s fn=%d/3 | handler: %d | listener event: %d | item: %d | siklus: %d | timeout: %d | %s",
			tostring(hooked.namecall), hooked.fn, state.raw, #listenConns, #items,
			state.cycles, state.timeouts, state.mode)
		task.wait(1)
	end
end)

refreshButtons()
